index 0000000..9de3546
--- /dev/null
+++ b/android/app/src/main/assets/sample-product-demo.json
@@ -0,0 +1,66 @@
+{
+  "title": "A Cue Without Looking Down",
+  "author": "Agile Lens",
+  "source": "Original text created for the Understudy sample pack, October 28, 2026. Not a quotation or a device-readiness claim.",
+  "acts": [
+    {
+      "number": 1,
+      "roman": "I",
+      "scenes": [
+        {
+          "number": 1,
+          "roman": "I",
+          "location": "Product demo",
+          "entries": [
+            {
+              "kind": "stage",
+              "text": "Original rehearsal text. Pause and resume at your own pace."
+            },
+            {
+              "kind": "line",
+              "character": "DEMO",
+              "text": "I am going to read a short scene while keeping my eyes up. The phone controls the script. The glasses show the words.",
+              "lineID": "1.1.1"
+            },
+            {
+              "kind": "line",
+              "character": "DEMO",
+              "text": "First I will use the single-line view. Watch the cue change as I move through the text. A long cue is divided into smaller pages.",
+              "lineID": "1.1.2"
+            },
+            {
+              "kind": "line",
+              "character": "DEMO",
+              "text": "Now I will switch to the flowing view. The active words are cyan. Earlier words dim, and the next words stay white.",
+              "lineID": "1.1.3"
+            },
+            {
+              "kind": "line",
+              "character": "DEMO",
+              "text": "I can pause here. Nothing should keep moving while I explain what you are seeing.",
+              "lineID": "1.1.4"
+            },
+            {
+              "kind": "line",
+              "character": "DEMO",
+              "text": "I can change the speed, resume, or drag back to a place I want to rehearse. Those controls stay on the phone.",
+              "lineID": "1.1.5"
+            },
+            {
+              "kind": "line",
+              "character": "DEMO",
+              "text": "This is a rehearsal aid. If I lose the connection, I will check it and reopen the glasses display from the phone.",
+              "lineID": "1.1.6"
+            },
+            {
+              "kind": "line",
+              "character": "DEMO",
+              "text": "The useful test is simple: can I keep the thought, find the next line, and keep looking at the person in front of me?",
+              "lineID": "1.1.7"
+            }
+          ]
+        }
+      ]
+    }
+  ]
+}
diff --git a/android/app/src/main/assets/sample-sixty-second-pitch.json b/android/app/src/main/assets/sample-sixty-second-pitch.json
new file mode 100644
index 0000000..52cd031
--- /dev/null
+++ b/android/app/src/main/assets/sample-sixty-second-pitch.json
@@ -0,0 +1,54 @@
+{
+  "title": "Keep the Rehearsal Moving",
+  "author": "Agile Lens",
+  "source": "Original text created for the Understudy sample pack, October 28, 2026. Not a quotation or a device-readiness claim.",
+  "acts": [
+    {
+      "number": 1,
+      "roman": "I",
+      "scenes": [
+        {
+          "number": 1,
+          "roman": "I",
+          "location": "60-second pitch at about 135 words per minute",
+          "entries": [
+            {
+              "kind": "stage",
+              "text": "Original rehearsal text. Pause and resume at your own pace."
+            },
+            {
+              "kind": "line",
+              "character": "PITCH",
+              "text": "A performer should not have to choose between remembering a line and looking at another person. Understudy explores a simple way to keep the next words nearby.",
+              "lineID": "1.1.1"
+            },
+            {
+              "kind": "line",
+              "character": "PITCH",
+              "text": "A director arranges marks and dialogue. A phone drives the reading position. A connected glasses display shows a short prompt or a flowing script.",
+              "lineID": "1.1.2"
+            },
+            {
+              "kind": "line",
+              "character": "PITCH",
+              "text": "The point is not to replace rehearsal. It is to remove a small interruption so people can spend more time working on the scene.",
+              "lineID": "1.1.3"
+            },
+            {
+              "kind": "line",
+              "character": "PITCH",
+              "text": "We can test that directly. Load a short script, read it with a partner, pause in the middle, and find the next line again.",
+              "lineID": "1.1.4"
+            },
+            {
+              "kind": "line",
+              "character": "PITCH",
+              "text": "Then tell us where the display helped and where it pulled your attention away. That answer is more useful than a polished claim. We want a tool that earns its place in the room.",
+              "lineID": "1.1.5"
+            }
+          ]
+        }
+      ]
+    }
+  ]
+}
diff --git a/android/app/src/main/assets/sample-stage-monologue.json b/android/app/src/main/assets/sample-stage-monologue.json
new file mode 100644
index 0000000..7a582cc
--- /dev/null
+++ b/android/app/src/main/assets/sample-stage-monologue.json
@@ -0,0 +1,72 @@
+{
+  "title": "The Last Work Light",
+  "author": "Agile Lens",
+  "source": "Original text created for the Understudy sample pack, October 28, 2026. Not a quotation or a device-readiness claim.",
+  "acts": [
+    {
+      "number": 1,
+      "roman": "I",
+      "scenes": [
+        {
+          "number": 1,
+          "roman": "I",
+          "location": "Stage monologue",
+          "entries": [
+            {
+              "kind": "stage",
+              "text": "Original rehearsal text. Pause and resume at your own pace."
+            },
+            {
+              "kind": "line",
+              "character": "MARA",
+              "text": "Leave that light on for a minute. I know the room is empty. That is why I can finally hear it.",
+              "lineID": "1.1.1"
+            },
+            {
+              "kind": "line",
+              "character": "MARA",
+              "text": "Yesterday there were twelve people here telling me where to stand. Tonight the floor has stopped giving orders.",
+              "lineID": "1.1.2"
+            },
+            {
+              "kind": "line",
+              "character": "MARA",
+              "text": "This mark is where I said goodbye. Two feet to the left is where I meant it. That is a small distance until you have to cross it.",
+              "lineID": "1.1.3"
+            },
+            {
+              "kind": "line",
+              "character": "MARA",
+              "text": "My father built sets. He could make a painted door sound like oak, but he could never leave a real door without checking the latch.",
+              "lineID": "1.1.4"
+            },
+            {
+              "kind": "line",
+              "character": "MARA",
+              "text": "I used to think that was fear. Now I think it was care. Someone had to know the room would hold after everyone went home.",
+              "lineID": "1.1.5"
+            },
+            {
+              "kind": "line",
+              "character": "MARA",
+              "text": "Tomorrow I will walk out there and say the line. I will probably put the emphasis in the wrong place. People survive that.",
+              "lineID": "1.1.6"
+            },
+            {
+              "kind": "line",
+              "character": "MARA",
+              "text": "What I cannot do is wait until I am certain. Certainty has missed every rehearsal we invited it to.",
+              "lineID": "1.1.7"
+            },
+            {
+              "kind": "line",
+              "character": "MARA",
+              "text": "All right. Turn it off. I know where the door is now.",
+              "lineID": "1.1.8"
+            }
+          ]
+        }
+      ]
+    }
+  ]
+}
diff --git a/android/app/src/main/assets/sample-toast.json b/android/app/src/main/assets/sample-toast.json
new file mode 100644
index 0000000..0248ec9
--- /dev/null
+++ b/android/app/src/main/assets/sample-toast.json
@@ -0,0 +1,60 @@
+{
+  "title": "To the People Who Stay",
+  "author": "Agile Lens",
+  "source": "Original text created for the Understudy sample pack, October 28, 2026. Not a quotation or a device-readiness claim.",
+  "acts": [
+    {
+      "number": 1,
+      "roman": "I",
+      "scenes": [
+        {
+          "number": 1,
+          "roman": "I",
+          "location": "Toast",
+          "entries": [
+            {
+              "kind": "stage",
+              "text": "Original rehearsal text. Pause and resume at your own pace."
+            },
+            {
+              "kind": "line",
+              "character": "HOST",
+              "text": "I will keep this short enough that the ice can survive it.",
+              "lineID": "1.1.1"
+            },
+            {
+              "kind": "line",
+              "character": "HOST",
+              "text": "We often celebrate the person who has the idea. Tonight I want to celebrate the people who stay when the idea becomes work.",
+              "lineID": "1.1.2"
+            },
+            {
+              "kind": "line",
+              "character": "HOST",
+              "text": "The people who bring another chair. The people who ask whether you ate. The people who can tell that your cheerful message means you need help.",
+              "lineID": "1.1.3"
+            },
+            {
+              "kind": "line",
+              "character": "HOST",
+              "text": "You have done that for us, in ways large enough to change a year and small enough that you probably forgot them.",
+              "lineID": "1.1.4"
+            },
+            {
+              "kind": "line",
+              "character": "HOST",
+              "text": "We did not forget. Raise a glass to the time you gave, the room you made, and the next ordinary evening we get to share.",
+              "lineID": "1.1.5"
+            },
+            {
+              "kind": "line",
+              "character": "HOST",
+              "text": "To all of you. Thank you for staying.",
+              "lineID": "1.1.6"
+            }
+          ]
+        }
+      ]
+    }
+  ]
+}
